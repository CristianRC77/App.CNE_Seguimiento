MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/
MONGODB_DATABASE=db_exterior_cne
MONGODB_COLLECTION=zona_electotal
MONGODB_USERS_COLLECTION=users
MONGODB_GENERAL_ROLE_ID=ID_DEL_ROL_OPERARIO_GENERAL
MONGODB_CIRC_ROLE_ID=ID_DEL_ROL_OPERARIO_CIRC
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
API_PORT=3001

# Solo es necesario si el frontend y la API están en proyectos distintos.
# En Vercel, la ruta base de la API incluye /api.
VITE_API_URL=https://tu-dominio.example/api
